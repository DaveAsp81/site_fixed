# Netlify response headers.
#
# Every asset on the site was being served with the platform default,
# "public, max-age=0, must-revalidate", including an 8 MB JPEG. That means a
# conditional request for every file on every page view. Static assets never
# change under the same filename, so they get a year; HTML stays revalidated
# so edits go live immediately.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# ── Immutable static assets ──────────────────────────────────────────
# The responsive derivatives carry their width in the filename, so a new
# size is a new URL and a long cache is safe.
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# NOT immutable, deliberately. style.css and site.js are edited in place
# rather than given a hashed filename, so a year-long immutable cache would
# mean an edit never reaching anyone who had already visited. An hour is long
# enough to cover a browsing session and short enough that a fix goes out the
# same morning. If these ever get content-hashed filenames, switch them to
# the immutable line used for images above.
/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600

/favicon.ico
  Cache-Control: public, max-age=2592000

# ── Data files ───────────────────────────────────────────────────────
# These are versioned with ?v= in the query string, which Netlify keys on.
/mechs.json
  Cache-Control: public, max-age=604800
  Content-Type: application/json; charset=utf-8

/vehicles.json
  Cache-Control: public, max-age=604800
  Content-Type: application/json; charset=utf-8

/mechs_mul_reference.json
  Cache-Control: public, max-age=604800
  Content-Type: application/json; charset=utf-8

/force-packs.json
  Cache-Control: public, max-age=604800
  Content-Type: application/json; charset=utf-8

# ── Things that must never be stale ──────────────────────────────────
/sw.js
  Cache-Control: no-cache

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json
